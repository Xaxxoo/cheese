# ─────────────────────────────────────────────────────────────
# 🧀 CHEESE PAY — Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Required fields are marked  ← REQUIRED
# Fields with defaults can be left as-is for local development.
# ─────────────────────────────────────────────────────────────


# ── App ──────────────────────────────────────────────────────

NODE_ENV=development                          # development | production | test
PORT=3001                                     # HTTP port the API listens on

# URL of the frontend PWA (used for CORS allow-list)
FRONTEND_URL=http://localhost:3000            # ← REQUIRED in production

# Base URL for generated PayLink share URLs
PAYLINK_BASE_URL=https://cheesepay.xyz        # ← REQUIRED in production

# Explicitly opt out of device signature enforcement for local debugging only.
# Leave unset or false in every real environment.
# This flag has no effect when NODE_ENV=production — the bypass is always disabled in production.
ALLOW_INSECURE_DEVICE_SIGNATURES=false


# ── PostgreSQL ───────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cheese_wallet
DB_USER=cheese
DB_PASS=cheese                                # ← REQUIRED (use a strong password in production)

# Optional: full connection URL (overrides individual DB_* vars)
# DATABASE_URL=postgresql://cheese:cheese@localhost:5432/cheese_wallet


# ── Redis ────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                               # Leave blank if Redis has no auth (local dev)
                                              # ← REQUIRED in production

# Optional: full Redis URL (overrides individual REDIS_* vars)
# REDIS_URL=redis://:password@localhost:6379


# ── JWT ──────────────────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_ACCESS_SECRET=replace-with-64-byte-random-hex       # ← REQUIRED
JWT_ACCESS_EXPIRES=15m                                   # Access token TTL (e.g. 15m, 1h)

JWT_REFRESH_SECRET=replace-with-different-64-byte-hex   # ← REQUIRED  (must differ from access secret)
JWT_REFRESH_EXPIRES=30d                                  # Refresh token TTL


# ── Rate Limiting (ThrottlerGuard) ───────────────────────────

THROTTLE_TTL=60          # Window size in seconds
THROTTLE_LIMIT=100       # Max requests per IP per window


# ── OTP ──────────────────────────────────────────────────────

OTP_TTL_SECONDS=900      # How long an OTP is valid (900 = 15 minutes)


# ── Resend (transactional email) ─────────────────────────────
# Sign up at: https://resend.com — add and verify your domain first.

RESEND_API_KEY=re_your-resend-api-key         # ← REQUIRED
EMAIL_FROM=hi@cheesepay.xyz                   # Must match a verified Resend sender domain
EMAIL_FROM_NAME=Cheese Pay
EMAIL_REPLY_TO=support@cheesepay.xyz


# ── Stellar Blockchain ───────────────────────────────────────

# "testnet" or "mainnet"
STELLAR_NETWORK=mainnet

# Horizon RPC endpoint
# Testnet:  https://horizon-testnet.stellar.org
# Mainnet:  https://horizon.stellar.org
STELLAR_HORIZON_URL=https://horizon.stellar.org

# USDC asset issuer address
# Testnet (Circle):  GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet (Circle):  GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Master keypair — funds new user wallets with XLM for fees and establishes USDC trustlines.
# Generate with: node -e "const sdk=require('@stellar/stellar-sdk');console.log(sdk.Keypair.random().secret())"
STELLAR_MASTER_SECRET=S...your-master-stellar-secret-key      # ← REQUIRED  (guard this carefully)

# Platform keypair — used to send USDC refunds back to users and to receive protocol withdrawals.
# Must hold enough XLM for transaction fees and a USDC trustline.
# Generate the same way as STELLAR_MASTER_SECRET above.
STELLAR_PLATFORM_SECRET_KEY=S...your-platform-stellar-secret  # ← REQUIRED

# AES-256-GCM key for encrypting all Stellar secret keys and card numbers at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STELLAR_WALLET_ENCRYPTION_KEY=replace-with-64-char-hex        # ← REQUIRED  (32 bytes = 64 hex chars)


# ── EVM deposits + treasury ─────────────────────────────────
# One platform EVM private key signs user-wallet deployments and vault actions.
# It must be funded with each chain's native gas token.
PLATFORM_WALLET_PRIVATE_KEY=0x...your-evm-platform-private-key
EVM_PRIMARY_CHAIN_ID=42220

# Optional global EVM vault withdrawal destination. Prefer a cold wallet or multisig.
# Chain-specific {CHAIN}_WITHDRAWAL_ADDRESS overrides this.
EVM_WITHDRAWAL_ADDRESS=0x...your-cold-wallet-or-multisig

# Celo mainnet
CELO_RPC_URL=https://forno.celo.org
CELO_FACTORY_ADDRESS=0x87ECa36C20Cf470d6e10be12812C96Fe06Ab79AE
CELO_VAULT_ADDRESS=0xC80F780D220b50C3C6910C66bb9C7E1c2aAcd555
CELO_USDC_ADDRESS=0xcebA9300f2b948710d2653dD7B07f33A8B32118C
CELO_USDT_ADDRESS=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
CELO_WITHDRAWAL_ADDRESS=

# Add the same group for BASE, ARBITRUM, POLYGON, and ETHEREUM after deployment:
# BASE_RPC_URL=
# BASE_FACTORY_ADDRESS=
# BASE_VAULT_ADDRESS=
# BASE_USDC_ADDRESS=
# BASE_USDT_ADDRESS=
# BASE_WITHDRAWAL_ADDRESS=


# ── Exchange Rate ────────────────────────────────────────────

# Provider URL that returns JSON with a top-level "rates" object keyed by currency code.
# ExchangeRate-API free tier: https://api.exchangerate-api.com/v4/latest/USD
# Open Exchange Rates:        https://openexchangerates.org/api/latest.json?app_id=YOUR_ID
EXCHANGE_RATE_URL=https://api.exchangerate-api.com/v4/latest/USD   # ← REQUIRED

# Platform spread deducted from the raw market rate (NGN effective rate shown to users).
# 1.5 means users receive 1.5% less than the raw mid-market rate.
NGN_SPREAD_PERCENT=1.5


# ── PulseMFB (NGN banking — account resolution + payouts) ────
# Obtain credentials from the PulseMFB developer portal.

PULSE_MFB_BASE_URL=https://api.pulsemfb.com   # root host only; client appends /api/v1/external-api
PULSE_MFB_PUBLIC_KEY=your-pulsemfb-public-key        # ← REQUIRED
PULSE_MFB_PRIVATE_KEY=your-pulsemfb-private-key      # ← REQUIRED  (used for HMAC request signing)
PULSE_MFB_DEBIT_ACCOUNT=your-platform-ngn-account    # ← REQUIRED  (platform's NGN account number at PulseMFB)
PULSE_MFB_DEBIT_ACCOUNT_ID=your-pulsemfb-account-id  # ← REQUIRED  (internal debit account ID for name enquiry)
PULSE_MFB_WEBHOOK_SECRET=your-pulsemfb-webhook-secret  # ← REQUIRED  (for verifying inbound webhook signatures)


# ── Flutterwave Bills ──────────────────────────────────────
FLUTTERWAVE_BILLS_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_BILLS_CLIENT_ID=your-flutterwave-client-id        # ← REQUIRED
FLUTTERWAVE_BILLS_CLIENT_SECRET=your-flutterwave-client-secret # ← REQUIRED
FLUTTERWAVE_BILLS_CALLBACK_URL=https://your-domain/v1/bills/webhook/flutterwave


# ── Referral ──────────────────────────────────────────────────

REFERRAL_REWARD_USDC=2   # USDC reward credited to referrer when their friend completes first transaction


# ── Dojah KYC ─────────────────────────────────────────────────
# Obtain credentials from https://app.dojah.io → Settings → API Keys
# Supports: BVN, NIN, face-match (selfie)

DOJAH_APP_ID=your-dojah-app-id          # ← REQUIRED for KYC
DOJAH_SECRET_KEY=your-dojah-secret-key  # ← REQUIRED for KYC


# ── Admin ─────────────────────────────────────────────────────
# Secret key for internal admin endpoints (e.g. Black tier approval).
# Generate with: openssl rand -hex 32

ADMIN_API_KEY=your-admin-api-key        # ← REQUIRED
